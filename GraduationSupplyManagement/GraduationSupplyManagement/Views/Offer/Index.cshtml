@model List<GraduationSupplyManagement.Models.SelectedOffer>

@{
    ViewData["Title"] = "Create Supply Request";
}

<div class="container mt-4">

    <h2>Graduation Supply Management</h2>
    <p>Select one offer from each category.</p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Message"]
        </div>
    }

    <form method="post" action="@Url.Action("SelectOffers", "Offer")">
        @Html.AntiForgeryToken()

        <h4>Graduation Certificates</h4>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var offer in Model)
                {
                    if (offer.Category == "Graduation Certificates")
                    {
                        <tr>
                            <td>
                                <input type="radio"
                                       name="certificateId"
                                       value="@offer.Id"
                                       required />
                            </td>
                            <td>@offer.SupplierName</td>
                            <td>@offer.OfferName</td>
                            <td>@offer.Quantity</td>
                            <td>@offer.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <h4 class="mt-4">Hospitality</h4>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var offer in Model)
                {
                    if (offer.Category == "Hospitality")
                    {
                        <tr>
                            <td>
                                <input type="radio"
                                       name="hospitalityId"
                                       value="@offer.Id"
                                       required />
                            </td>
                            <td>@offer.SupplierName</td>
                            <td>@offer.OfferName</td>
                            <td>@offer.Quantity</td>
                            <td>@offer.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <h4 class="mt-4">Graduation Gifts</h4>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var offer in Model)
                {
                    if (offer.Category == "Graduation Gifts")
                    {
                        <tr>
                            <td>
                                <input type="radio"
                                       name="giftId"
                                       value="@offer.Id"
                                       required />
                            </td>
                            <td>@offer.SupplierName</td>
                            <td>@offer.OfferName</td>
                            <td>@offer.Quantity</td>
                            <td>@offer.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary mt-3">
            Review Selected Offers
        </button>

    </form>
</div>
