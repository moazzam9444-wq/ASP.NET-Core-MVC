@model List<GraduationSupplyManagement.Models.SelectedOffer>

@{
    ViewData["Title"] = "Review Request";
}

<div class="container mt-4">

    <h2>Review Selected Offers</h2>

    <table class="table table-bordered table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Supplier</th>
                <th>Offer</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@Model[i].Category</td>
                    <td>@Model[i].SupplierName</td>
                    <td>@Model[i].OfferName</td>
                    <td>@Model[i].Quantity</td>
                    <td>@Model[i].UnitPrice JD</td>
                    <td>@ViewBag.OfferTotals[i] JD</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-4">
        <div class="card-body">

            <h4>Cost Summary</h4>

            <p>Total Price: @ViewBag.Total JD</p>
            <p>Discount: @ViewBag.Discount%</p>
            <p>Discount Amount: @ViewBag.DiscountAmount JD</p>

            <hr />

            <h4 class="text-success">
                Final Total: @ViewBag.FinalTotal JD
            </h4>

        </div>
    </div>

    <a href="@Url.Action("Index", "Offer")"
       class="btn btn-secondary mt-3">
        Back to Offers
    </a>

</div>
