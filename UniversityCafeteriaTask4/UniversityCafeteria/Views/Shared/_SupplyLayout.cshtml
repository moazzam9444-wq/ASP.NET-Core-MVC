
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index", "SupplyRequest")">
                Supply Management
            </a>

            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "SupplyRequest")">
                        Create Request
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Review", "SupplyRequest")">
                        Review Draft
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("MyRequests", "SupplyRequest")">
                        My Requests
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("About", "SupplyRequest")">
                        About
                    </a>
                </li>

            </ul>

        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
