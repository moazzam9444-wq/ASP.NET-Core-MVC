
@model List<UniversityCafeteria.Models.SupplyItem>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-3">

        <div class="card-header bg-primary text-white p-3">
            <h4 class="mb-0">Supply Request Review</h4>
        </div>

        <div class="card-body">

            <div class="alert alert-info">
                Total Products: <strong>@Model.Count</strong>
            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning">
                    No products added yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered align-middle text-center">

                        <thead class="table-dark">
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                                <th>Priority</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.ProductName</td>
                                    <td>@item.Category</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice JD</td>
                                    <td>@(item.Quantity * item.UnitPrice) JD</td>
                                    <td>
                                        @if (item.Priority == "Emergency")
                                        {
                                            <span class="badge bg-danger">Emergency</span>
                                        }
                                        else if (item.Priority == "Urgent")
                                        {
                                            <span class="badge bg-warning text-dark">Urgent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Normal</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card bg-light border-0 mt-4">
                    <div class="card-body">

                        <h5 class="mb-3">Request Summary</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <strong>@ViewBag.Subtotal JD</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Priority Fee:</span>
                            <strong>@ViewBag.PriorityFee JD</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Discount:</span>
                            <strong>- @ViewBag.Discount JD</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between text-primary">
                            <h5>Final Total:</h5>
                            <h5>@ViewBag.FinalTotal JD</h5>
                        </div>

                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-3">

    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-primary">
        + Add Another Product
    </a>

    <form method="post"
          action="@Url.Action("ClearDraft", "SupplyRequest")">

        <button type="submit" class="btn btn-danger">
            Clear Draft
        </button>

    </form>
    <form method="post"
      action="@Url.Action("ConfirmRequest", "SupplyRequest")">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-success">
        Confirm Request
    </button>

</form>


</div>

        </div>
    </div>
</div>
