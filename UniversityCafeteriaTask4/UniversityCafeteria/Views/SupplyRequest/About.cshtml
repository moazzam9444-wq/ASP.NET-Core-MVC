
@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">About Our System</h4>
        </div>

        <div class="card-body">

            <h5>University Cafeteria Supply Request Management System</h5>

            <p class="text-muted">
                This system helps manage cafeteria supply requests
                in a simple and organized way.
            </p>

            <hr />

            <h5>System Features</h5>

            <ul class="list-group mb-4">
                <li class="list-group-item">
                    Add multiple products to a supply request
                </li>

                <li class="list-group-item">
                    Review products and calculate total prices
                </li>

                <li class="list-group-item">
                    Apply priority fees and discounts
                </li>

                <li class="list-group-item">
                    Save draft products using Session
                </li>

                <li class="list-group-item">
                    Save preferred priority using Cookies
                </li>

                <li class="list-group-item">
                    Confirm requests and view request history
                </li>
            </ul>

            <h5>Technologies Used</h5>

            <p>
                ASP.NET Core MVC, C#, Razor,
                HTML, CSS, and Bootstrap.
            </p>

            <a href="@Url.Action("Index", "SupplyRequest")"
               class="btn btn-primary">
                Back to Home
            </a>

        </div>
    </div>

</div>
