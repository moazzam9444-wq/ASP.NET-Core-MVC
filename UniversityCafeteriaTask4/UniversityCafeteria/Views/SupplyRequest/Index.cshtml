
@{
    ViewData["Title"] = "Create Supply Request";
}

<div class="container mt-5">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Create Supply Request</h4>
        </div>

        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Error2"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error2"]
                </div>
            }

            @if (TempData["Error3"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error3"]
                </div>
            }

            <form method="post"
                  action="@Url.Action("AddItem", "SupplyRequest")">

                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="ProductName"
                           class="form-control"
                           placeholder="Enter product name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="Category" class="form-select" required>
                        <option value="">Select Category</option>
                        <option value="Drinks">Drinks</option>
                        <option value="Food">Food</option>
                        <option value="Packaging">Packaging</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Quantity"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unit Price (JD)</label>
                        <input type="number" name="UnitPrice"
                               class="form-control"
                               step="0.5" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Priority</label>

                    <select name="Priority" class="form-select" required>
                        <option value="Normal"
                                selected="@(ViewBag.PreferredPriority == "Normal")">
                            Normal
                        </option>

                        <option value="Urgent"
                                selected="@(ViewBag.PreferredPriority == "Urgent")">
                            Urgent
                        </option>

                        <option value="Emergency"
                                selected="@(ViewBag.PreferredPriority == "Emergency")">
                            Emergency
                        </option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    Add Item
                </button>

            </form>
        </div>
    </div>

    <!-- Save Preferred Priority -->
    <div class="card shadow border-0 mt-4">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Priority Preferences</h5>
        </div>

        <div class="card-body">

            <div class="alert alert-info">
                Current Preferred Priority:
                <strong>@ViewBag.PreferredPriority</strong>
            </div>

            <form method="post"
                  action="@Url.Action("SavePreference", "SupplyRequest")">

                <div class="mb-3">
                    <label class="form-label">
                        Choose Your Preferred Priority
                    </label>

                    <select name="Priority" class="form-select">
                        <option value="Normal"
                                selected="@(ViewBag.PreferredPriority == "Normal")">
                            Normal
                        </option>

                        <option value="Urgent"
                                selected="@(ViewBag.PreferredPriority == "Urgent")">
                            Urgent
                        </option>

                        <option value="Emergency"
                                selected="@(ViewBag.PreferredPriority == "Emergency")">
                            Emergency
                        </option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Preference
                </button>

            </form>

        </div>
    </div>

</div>
