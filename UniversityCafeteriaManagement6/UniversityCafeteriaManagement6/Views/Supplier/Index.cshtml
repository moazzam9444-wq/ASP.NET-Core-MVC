@model List<Supplier>

    <H1>List Of Suppliers</H1>
<a href="/Supplier/Create" class="btn btn-primary mb-3">
    Add New Supplier
</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Phone</th>
            <th scope="col">Email</th>
            <th>Products Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>
                    <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary" >Edit</a>
                    <a asp-controller="Supplier" asp-action="Deteils" asp-route-id="@item.Id" class="btn btn-success">Deteils</a>
                    <form action="/Supplier/Delete" method="post"
                          onsubmit="return confirm('Are you sure?')" class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@item.Id" />

                        <button type="submit" class="btn btn-danger ">
                            Delete
                        </button>

                    </form>
                </td>
                <td>
    @(((List<Product>)ViewBag.Products)
        .Count(p => p.SupplierId == item.Id))
</td>
            </tr>
        }

    </tbody>
</table>

